{
  "name": "bymayo/craft-points",
  "description": "Loyalty points, leaderboards, and tiered user levels for Craft CMS.",
  "type": "craft-plugin",
  "license": "proprietary",
  "support": {
    "email": "jason@bymayo.co.uk",
    "issues": "https://github.com/bymayo/craft-points/issues?state=open",
    "source": "https://github.com/bymayo/craft-points",
    "docs": "https://github.com/bymayo/craft-points",
    "rss": "https://github.com/bymayo/craft-points/releases.atom"
  },
  "require": {
    "php": ">=8.2",
    "craftcms/cms": "^5.6.0"
  },
  "suggest": {
    "craftcms/commerce": "Adds Commerce triggers — award points when an order completes or a subscription is created."
  },
  "require-dev": {
    "craftcms/phpstan": "dev-main"
  },
  "autoload": {
    "psr-4": {
      "bymayo\\points\\": "src/"
    }
  },
  "extra": {
    "handle": "points",
    "name": "Points",
    "developer": "ByMayo",
    "documentationUrl": "https://github.com/bymayo/craft-points",
    "changelogUrl": "https://raw.githubusercontent.com/bymayo/craft-points/craft-5/CHANGELOG.md",
    "class": "bymayo\\points\\Points",
    "editions": ["lite", "pro"]
  },
  "config": {
    "sort-packages": true,
    "platform": {
      "php": "8.2"
    },
    "allow-plugins": {
      "yiisoft/yii2-composer": true,
      "craftcms/plugin-installer": true
    }
  }
}