{% extends '_layouts/cp' %}

{% set title = 'Leaderboard'|t('points') %}
{% set selectedSubnavItem = 'leaderboard' %}

{% set crumbs = [
    { label: craft.points.pluginName, url: url('points') },
] %}

{% do view.registerAssetBundle('craft\\web\\assets\\admintable\\AdminTableAsset') %}

{% block content %}
    <div id="leaderboard-vue-admin-table"></div>
{% endblock %}

{% js %}
    new Craft.VueAdminTable({
        columns: [
            { name: 'rank', title: Craft.t('points', '#'), titleClass: 'thin' },
            { name: '__slot:title', title: Craft.t('points', 'User') },
            { name: 'level', title: Craft.t('points', 'Level'), callback: (v) => v || '' },
            { name: 'points', title: Craft.t('points', '{currency}', { currency: '{{ craft.points.currencyPlural }}' }) },
            {% if craft.points.isPro and craft.app.plugins.isPluginEnabled('commerce') %}
            { name: 'availableSpend', title: Craft.t('points', 'Available Spend') },
            { name: 'redeemed', title: Craft.t('points', 'Redeemed') },
            {% endif %}
        ],
        container: '#leaderboard-vue-admin-table',
        emptyMessage: Craft.t('points', 'No awards yet.'),
        tableDataEndpoint: 'points/leaderboard/table-data',
        search: false,
    });
{% endjs %}
