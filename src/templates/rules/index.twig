{% extends '_layouts/cp' %}

{% set title = 'Rules'|t('points') %}
{% set selectedSubnavItem = 'rules' %}

{% set crumbs = [
    { label: craft.points.pluginName, url: url('points') },
] %}

{% do view.registerAssetBundle('craft\\web\\assets\\admintable\\AdminTableAsset') %}

{% block actionButton %}
    <a href="{{ url('points/rules/new') }}" class="btn submit add icon">
        {{ 'New rule'|t('points') }}
    </a>
{% endblock %}

{% block content %}
    <div id="rules-vue-admin-table"></div>
{% endblock %}

{% js %}
    new Craft.VueAdminTable({
        columns: [
            { name: '__slot:title', title: Craft.t('points', 'Name'), sortField: false },
            { name: '__slot:handle', title: Craft.t('points', 'Handle'), sortField: false },
            { name: 'trigger', title: Craft.t('points', 'Trigger') },
            { name: 'award', title: Craft.t('points', 'Award') },
            { name: 'limit', title: Craft.t('points', 'Limit') },
            { name: 'schedule', title: Craft.t('points', 'Active') },
            { name: 'status', title: Craft.t('points', 'Status'), callback: (v) => v },
        ],
        container: '#rules-vue-admin-table',
        emptyMessage: Craft.t('points', 'No rules yet.'),
        tableDataEndpoint: 'points/rules/table-data',
        deleteAction: 'points/rules/delete',
        search: true,
    });
{% endjs %}
