{# Renders a single condition or limit row, called both from _edit.twig's
   initial loop AND from the AJAX add-row endpoint so the registered JS for
   element-selects gets captured on the wire and re-injected client-side. #}

{% import '_includes/forms.twig' as forms %}

{% set operatorOptions = [
    { label: 'equals'|t('points'), value: '=' },
    { label: 'does not equal'|t('points'), value: '!=' },
    { label: 'is less than'|t('points'), value: '<' },
    { label: 'is less than or equals'|t('points'), value: '<=' },
    { label: 'is greater than'|t('points'), value: '>' },
    { label: 'is greater than or equals'|t('points'), value: '>=' },
    { label: 'is between…'|t('points'), value: 'between' },
] %}

{% set periodOptions = [
    { label: 'hour'|t('points'), value: 'hour' },
    { label: 'day'|t('points'), value: 'day' },
    { label: 'week'|t('points'), value: 'week' },
    { label: 'month'|t('points'), value: 'month' },
    { label: 'year'|t('points'), value: 'year' },
] %}

{% set condition = condition ?? { type: '' } %}
{% set limit = limit ?? { type: '' } %}
{% set productLookup = productLookup ?? {} %}

{% if section == 'conditions' %}
    {% set prefix = 'conditions[' ~ index ~ ']' %}
    <div class="points-row" data-section="conditions" data-index="{{ index }}">
        <div class="select cnd-type-wrap">
            <select name="{{ prefix }}[type]" class="cnd-type">
                <option value="">{{ 'Choose…'|t('points') }}</option>
                {% for opt in conditionTypes %}
                    <option value="{{ opt.value }}" data-subjects="{{ opt.subjects }}" {% if opt.value == condition.type %}selected{% endif %}>{{ opt.label }}</option>
                {% endfor %}
            </select>
        </div>

        <div class="cnd-value">
            <div class="cnd-variant" data-variant="section" {% if condition.type != 'section' %}hidden{% endif %}>
                {{ forms.checkboxSelect({ name: prefix ~ '[ids]', options: sectionOptions, values: condition.type == 'section' ? (condition.ids ?? []) : [], showAllOption: false }) }}
            </div>
            <div class="cnd-variant" data-variant="userGroup" {% if condition.type != 'userGroup' %}hidden{% endif %}>
                {{ forms.checkboxSelect({ name: prefix ~ '[groupIds]', options: userGroupOptions, values: condition.type == 'userGroup' ? (condition.groupIds ?? []) : [], showAllOption: false }) }}
            </div>
            <div class="cnd-variant cnd-inline" data-variant="commerce.orderTotal" {% if condition.type != 'commerce.orderTotal' %}hidden{% endif %}>
                {{ forms.select({ name: prefix ~ '[operator]', options: operatorOptions, value: condition.type == 'commerce.orderTotal' ? (condition.operator ?? '>=') : '>=', class: 'op-select' }) }}
                <span class="op-value">{{ forms.text({ name: prefix ~ '[value]', type: 'number', value: condition.type == 'commerce.orderTotal' ? (condition.value ?? '') : '' }) }}</span>
                <span class="op-and cnd-suffix">{{ 'and'|t('points') }}</span>
                <span class="op-value2">{{ forms.text({ name: prefix ~ '[value2]', type: 'number', value: condition.type == 'commerce.orderTotal' ? (condition.value2 ?? '') : '' }) }}</span>
            </div>
            <div class="cnd-variant cnd-inline" data-variant="commerce.orderItemCount" {% if condition.type != 'commerce.orderItemCount' %}hidden{% endif %}>
                {{ forms.select({ name: prefix ~ '[operator]', options: operatorOptions, value: condition.type == 'commerce.orderItemCount' ? (condition.operator ?? '>=') : '>=', class: 'op-select' }) }}
                <span class="op-value">{{ forms.text({ name: prefix ~ '[value]', type: 'number', value: condition.type == 'commerce.orderItemCount' ? (condition.value ?? '') : '' }) }}</span>
                <span class="op-and cnd-suffix">{{ 'and'|t('points') }}</span>
                <span class="op-value2">{{ forms.text({ name: prefix ~ '[value2]', type: 'number', value: condition.type == 'commerce.orderItemCount' ? (condition.value2 ?? '') : '' }) }}</span>
            </div>
            <div class="cnd-variant cnd-inline" data-variant="commerce.hasCoupon" {% if condition.type != 'commerce.hasCoupon' %}hidden{% endif %}>
                {{ forms.select({
                    name: prefix ~ '[hasCoupon]',
                    options: [
                        { label: 'has a coupon code'|t('points'), value: '1' },
                        { label: 'has no coupon code'|t('points'), value: '0' },
                    ],
                    value: condition.type == 'commerce.hasCoupon' ? ((condition.hasCoupon ?? true) ? '1' : '0') : '1',
                }) }}
            </div>
            <div class="cnd-variant" data-variant="commerce.containsProduct" {% if condition.type != 'commerce.containsProduct' %}hidden{% endif %}>
                {% set selectedProducts = condition.type == 'commerce.containsProduct' ? (productLookup[index] ?? []) : [] %}
                {{ forms.elementSelect({
                    name: prefix ~ '[productIds]',
                    elementType: 'craft\\commerce\\elements\\Product',
                    elements: selectedProducts,
                    limit: null,
                    selectionLabel: 'Add products'|t('points'),
                }) }}
            </div>
        </div>

        <button type="button" class="cnd-remove" title="{{ 'Remove'|t('points') }}" aria-label="{{ 'Remove'|t('points') }}">×</button>
    </div>

{% elseif section == 'limits' %}
    {% set prefix = 'limits[' ~ index ~ ']' %}
    <div class="points-row" data-section="limits" data-index="{{ index }}">
        {{ forms.select({
            name: prefix ~ '[type]',
            options: [{ label: 'Choose…'|t('points'), value: '' }]|merge(limitTypes),
            value: limit.type,
            class: 'cnd-type',
        }) }}

        <div class="cnd-value">
            <div class="cnd-variant" data-variant="oncePerUser" {% if limit.type != 'oncePerUser' %}hidden{% endif %}>
                <span class="cnd-suffix cnd-note">{{ 'at most once per user, ever'|t('points') }}</span>
            </div>
            <div class="cnd-variant cnd-inline" data-variant="maxPerUser" {% if limit.type != 'maxPerUser' %}hidden{% endif %}>
                {{ forms.text({ name: prefix ~ '[max]', type: 'number', placeholder: 'N'|t('points'), value: limit.type == 'maxPerUser' ? (limit.max ?? '') : '' }) }}
                <span class="cnd-suffix">{{ 'times per user, ever'|t('points') }}</span>
            </div>
            <div class="cnd-variant cnd-inline" data-variant="perPeriod" {% if limit.type != 'perPeriod' %}hidden{% endif %}>
                {{ forms.text({ name: prefix ~ '[max]', type: 'number', placeholder: 'N'|t('points'), value: limit.type == 'perPeriod' ? (limit.max ?? '') : '' }) }}
                <span class="cnd-suffix">{{ 'per'|t('points') }}</span>
                {{ forms.select({ name: prefix ~ '[period]', options: periodOptions, value: limit.type == 'perPeriod' ? (limit.period ?? 'day') : 'day' }) }}
            </div>
            <div class="cnd-variant cnd-inline" data-variant="cooldown" {% if limit.type != 'cooldown' %}hidden{% endif %}>
                {{ forms.text({ name: prefix ~ '[seconds]', type: 'number', placeholder: 'Seconds'|t('points'), value: limit.type == 'cooldown' ? (limit.seconds ?? '') : '' }) }}
                <span class="cnd-suffix">{{ 'seconds between awards'|t('points') }}</span>
            </div>
        </div>

        <button type="button" class="cnd-remove" title="{{ 'Remove'|t('points') }}" aria-label="{{ 'Remove'|t('points') }}">×</button>
    </div>
{% endif %}
