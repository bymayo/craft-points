{% extends '_layouts/cp' %}

{% set title = 'Events'|t('points') %}
{% set selectedSubnavItem = 'events' %}

{% set crumbs = [
    { label: craft.points.currencyPlural, url: url('points') },
] %}

{% block actionButton %}
    <a href="{{ url('points/events/new') }}" class="btn submit add icon">
        {{ 'New event'|t('points') }}
    </a>
{% endblock %}

{% block content %}
    {% if events|length %}
        <table class="data fullwidth collapsible">
            <thead>
                <tr>
                    <th scope="col">{{ 'Name'|t('points') }}</th>
                    <th scope="col">{{ 'Handle'|t('points') }}</th>
                    <th scope="col">{{ craft.points.currencyPlural }}</th>
                    <th scope="col">{{ 'Multiple'|t('points') }}</th>
                    <th scope="col">{{ 'Trigger'|t('points') }}</th>
                    <th scope="col"></th>
                </tr>
            </thead>
            <tbody>
                {% for event in events %}
                    <tr>
                        <td>
                            <a href="{{ url('points/events/' ~ event.id) }}">{{ event.name }}</a>
                        </td>
                        <td><code>{{ event.handle }}</code></td>
                        <td>{{ event.points }}{% if event.pointsType == 'percent' %}%{% endif %}</td>
                        <td>{{ event.multiple ? 'Yes'|t('points') : 'No'|t('points') }}</td>
                        <td>
                            {% if event.trigger %}
                                <code>{{ event.trigger }}</code>
                            {% else %}
                                <span style="opacity:0.5;">{{ 'Manual'|t('points') }}</span>
                            {% endif %}
                        </td>
                        <td class="thin">
                            <form method="post" onsubmit="return confirm('{{ 'Delete this event?'|t('points') }}');">
                                {{ csrfInput() }}
                                {{ actionInput('points/events/delete') }}
                                <input type="hidden" name="id" value="{{ event.id }}">
                                <button type="submit" class="btn small delete icon" title="{{ 'Delete'|t('app') }}"></button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% else %}
        <div class="zilch">
            <p>{{ "No events yet."|t('points') }}</p>
        </div>
    {% endif %}
{% endblock %}
