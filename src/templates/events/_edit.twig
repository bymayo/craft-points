{% extends '_layouts/cp' %}

{% import '_includes/forms.twig' as forms %}

{% set selectedSubnavItem = 'events' %}
{% set fullPageForm = true %}

{% set crumbs = [
    { label: craft.points.currencyPlural, url: url('points') },
    { label: 'Events'|t('points'), url: url('points/events') },
] %}

{% block content %}
    {{ actionInput('points/events/save') }}
    {{ redirectInput('points/events') }}
    {% if event.id %}
        <input type="hidden" name="eventId" value="{{ event.id }}">
    {% endif %}

    {{ forms.textField({
        first: true,
        label: 'Name'|t('points'),
        id: 'name',
        name: 'name',
        value: event.name,
        autofocus: true,
        required: true,
        errors: event.getErrors('name'),
    }) }}

    {{ forms.textField({
        label: 'Handle'|t('points'),
        id: 'handle',
        name: 'handle',
        class: 'code',
        value: event.handle,
        required: true,
        errors: event.getErrors('handle'),
    }) }}

    {% set pointsTypeOptions = [{ label: 'Flat amount'|t('points'), value: 'flat' }] %}
    {% if isPro %}
        {% set pointsTypeOptions = pointsTypeOptions|merge([{ label: 'Percentage of order total'|t('points'), value: 'percent' }]) %}
    {% endif %}

    {{ forms.selectField({
        label: 'Points type'|t('points'),
        instructions: isPro ? null : 'Percentage of order total is available on the Pro edition.'|t('points'),
        id: 'pointsType',
        name: 'pointsType',
        options: pointsTypeOptions,
        value: event.pointsType ?? 'flat',
    }) }}

    {{ forms.textField({
        label: 'Value'|t('points'),
        instructions: 'Flat: number of points awarded. Percent: percentage of order total — only fires from Commerce triggers that provide an amount.'|t('points'),
        id: 'points',
        name: 'points',
        type: 'number',
        value: event.points,
        required: true,
        errors: event.getErrors('points'),
    }) }}

    {{ forms.lightswitchField({
        label: 'Allow multiple'|t('points'),
        instructions: 'When on, a user can be awarded points from this event more than once.'|t('points'),
        id: 'multiple',
        name: 'multiple',
        on: event.multiple,
    }) }}

    <hr>

    {{ forms.selectField({
        label: 'Trigger'|t('points'),
        instructions: 'When should this event fire? "Manual" means only when called from Twig or the CP.'|t('points'),
        id: 'trigger',
        name: 'trigger',
        options: triggerOptions,
        value: event.trigger ?? '',
    }) }}

    <div id="points-trigger-configs">
        {% for trigger in scopedTriggers %}
            {% set isActive = (event.trigger == trigger.handle) %}
            {% set selectedScopeIds = isActive ? (event.triggerConfig.scopeIds ?? []) : [] %}
            <div data-trigger="{{ trigger.handle }}"{% if not isActive %} class="hidden"{% endif %}>
                {{ forms.checkboxSelectField({
                    label: ('Limit to ' ~ trigger.scopedTo)|t('points'),
                    instructions: 'Leave all unchecked to apply to every {scope}.'|t('points', { scope: trigger.scopedTo }),
                    name: 'triggerConfig[' ~ trigger.handle ~ '][scopeIds]',
                    options: trigger.scopeOptions,
                    values: selectedScopeIds,
                    showAllOption: false,
                }) }}
            </div>
        {% endfor %}
    </div>

    {% js %}
        (function() {
            var sel = document.getElementById('trigger');
            if (!sel) return;
            var container = document.getElementById('points-trigger-configs');
            if (!container) return;
            function update() {
                var val = sel.value;
                container.querySelectorAll('[data-trigger]').forEach(function(el) {
                    if (el.dataset.trigger === val) {
                        el.classList.remove('hidden');
                    } else {
                        el.classList.add('hidden');
                    }
                });
            }
            sel.addEventListener('change', update);
            update();
        })();
    {% endjs %}
{% endblock %}
