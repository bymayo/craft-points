{% extends '_layouts/cp' %}

{% import '_includes/forms.twig' as forms %}

{% set selectedSubnavItem = 'awards' %}
{% set fullPageForm = true %}

{% set crumbs = [
    { label: craft.points.currencyPlural, url: url('points') },
    { label: 'Awards'|t('points'), url: url('points/awards') },
] %}

{% set eventOptions = [{ label: '----'|t('points'), value: '' }] %}
{% for event in events %}
    {% set suffix = event.pointsType == 'percent' ? '%' : ' ' ~ craft.points.currencyPlural %}
    {% set eventOptions = eventOptions|merge([{
        label: event.name ~ ' (' ~ event.points ~ suffix ~ ')',
        value: event.id,
    }]) %}
{% endfor %}

{% block content %}
    {{ actionInput('points/awards/save') }}
    {{ redirectInput('points/awards') }}
    {% if award.id %}
        <input type="hidden" name="awardId" value="{{ award.id }}">
    {% endif %}

    {{ forms.elementSelectField({
        first: true,
        label: 'User'|t('points'),
        id: 'userId',
        name: 'userId',
        elementType: 'craft\\elements\\User',
        elements: award.user ? [award.user] : null,
        limit: 1,
        required: true,
        errors: award.getErrors('userId'),
    }) }}

    {{ forms.selectField({
        label: 'Event'|t('points'),
        id: 'eventId',
        name: 'eventId',
        options: eventOptions,
        value: award.eventId,
        required: true,
        errors: award.getErrors('eventId'),
    }) }}

    {% if award.id %}
        {{ forms.textField({
            label: craft.points.currencyPlural,
            instructions: 'Snapshot of the event\'s points value when this award was created. Editing the event later won\'t change this.'|t('points'),
            id: 'pointsSnapshot',
            name: 'pointsSnapshot',
            type: 'number',
            value: award.pointsSnapshot,
            disabled: true,
        }) }}
    {% endif %}
{% endblock %}
