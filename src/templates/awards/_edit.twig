{% extends '_layouts/cp' %}

{% import '_includes/forms.twig' as forms %}

{% set selectedSubnavItem = 'awards' %}
{% set fullPageForm = true %}

{% set crumbs = [
    { label: craft.points.pluginName, url: url('points') },
    { label: 'Awards'|t('points'), url: url('points/awards') },
] %}

{% set ruleOptions = [{ label: '----'|t('points'), value: '' }] %}
{% for rule in rules %}
    {% if rule.handle != '__redemption' %}
        {% set ruleOptions = ruleOptions|merge([{
            label: rule.name ~ ' (' ~ rule.getRewardSummary() ~ ')',
            value: rule.id,
        }]) %}
    {% endif %}
{% endfor %}

{% block content %}
    {{ actionInput('points/awards/save') }}
    {{ redirectInput('points/awards') }}
    {% if award.id %}
        <input type="hidden" name="awardId" value="{{ award.id }}">
    {% endif %}

    {{ forms.elementSelectField({
        first: true,
        label: 'User'|t('points'),
        id: 'userId',
        name: 'userId',
        elementType: 'craft\\elements\\User',
        elements: award.user ? [award.user] : null,
        limit: 1,
        required: true,
        errors: award.getErrors('userId'),
    }) }}

    {{ forms.selectField({
        label: 'Rule'|t('points'),
        id: 'ruleId',
        name: 'ruleId',
        options: ruleOptions,
        value: award.ruleId,
        required: true,
        errors: award.getErrors('ruleId'),
    }) }}

    {% if award.id %}
        {{ forms.textField({
            label: craft.points.currencyPlural,
            instructions: 'Snapshot of the rule\'s points value when this award was created. Editing the rule later won\'t change this.'|t('points'),
            id: 'pointsSnapshot',
            name: 'pointsSnapshot',
            type: 'number',
            value: award.pointsSnapshot,
            disabled: true,
        }) }}
    {% endif %}
{% endblock %}
