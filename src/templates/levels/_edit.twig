{% extends '_layouts/cp' %}

{% import '_includes/forms.twig' as forms %}

{% set selectedSubnavItem = 'levels' %}
{% set fullPageForm = true %}

{% set crumbs = [
    { label: craft.points.pluginName, url: url('points') },
    { label: 'Levels'|t('points'), url: url('points/levels') },
] %}

{% block content %}
    {{ actionInput('points/levels/save') }}
    {{ redirectInput('points/levels') }}
    {% if level.id %}
        <input type="hidden" name="levelId" value="{{ level.id }}">
    {% endif %}

    {{ forms.textField({
        first: true,
        label: 'Name'|t('points'),
        id: 'name',
        name: 'name',
        value: level.name,
        autofocus: true,
        required: true,
        errors: level.getErrors('name'),
    }) }}

    {{ forms.textField({
        label: 'Handle'|t('points'),
        id: 'handle',
        name: 'handle',
        class: 'code',
        value: level.handle,
        required: true,
        errors: level.getErrors('handle'),
    }) }}

    {% js %}new Craft.HandleGenerator('#name', '#handle');{% endjs %}

    {{ forms.textField({
        label: 'Threshold'|t('points'),
        instructions: 'Minimum number of points a user needs to reach this level.'|t('points'),
        id: 'threshold',
        name: 'threshold',
        type: 'number',
        value: level.threshold,
        required: true,
        errors: level.getErrors('threshold'),
    }) }}

    {{ forms.colorField({
        label: 'Color'|t('app'),
        id: 'colour',
        name: 'colour',
        value: level.colour,
        errors: level.getErrors('colour'),
    }) }}

    {% set selectedIcon = level.icon and level.icon is numeric
        ? craft.assets().id(level.icon).one()
        : null %}

    {{ forms.elementSelectField({
        label: 'Icon'|t('app'),
        id: 'icon',
        name: 'icon',
        elementType: 'craft\\elements\\Asset',
        elements: selectedIcon ? [selectedIcon] : [],
        limit: 1,
        selectionLabel: 'Choose icon'|t('points'),
        criteria: { kind: 'image' },
        errors: level.getErrors('icon'),
    }) }}
{% endblock %}
