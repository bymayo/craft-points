{% extends '_layouts/cp' %}

{% set title = 'Levels'|t('points') %}
{% set selectedSubnavItem = 'levels' %}

{% set crumbs = [
    { label: craft.points.pluginName, url: url('points') },
] %}

{% do view.registerAssetBundle('craft\\web\\assets\\admintable\\AdminTableAsset') %}

{% block actionButton %}
    <a href="{{ url('points/levels/new') }}" class="btn submit add icon">
        {{ 'New level'|t('points') }}
    </a>
{% endblock %}

{% block content %}
    <div id="levels-vue-admin-table"></div>
{% endblock %}

{% js %}
    new Craft.VueAdminTable({
        columns: [
            { name: '__slot:title', title: Craft.t('points', 'Name') },
            { name: '__slot:handle', title: Craft.t('points', 'Handle') },
            { name: 'threshold', title: Craft.t('points', 'Threshold') },
            { name: 'colour', title: Craft.t('app', 'Color'), callback: (v) => v || '' },
        ],
        container: '#levels-vue-admin-table',
        emptyMessage: Craft.t('points', 'No levels yet.'),
        tableDataEndpoint: 'points/levels/table-data',
        deleteAction: 'points/levels/delete',
        search: true,
    });
{% endjs %}
