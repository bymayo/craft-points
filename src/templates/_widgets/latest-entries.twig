{% if entries|length %}
    <ul style="margin:0; padding:0; list-style:none;">
        {% for entry in entries %}
            <li style="padding:6px 0; border-bottom:1px solid rgba(0,0,0,.06); display:flex; align-items:center; gap:8px;">
                {% if entry.user %}
                    <a href="{{ entry.user.getCpEditUrl() }}" style="flex:1; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">{{ entry.user.name }}</a>
                {% else %}
                    <span style="flex:1; opacity:0.5;">{{ 'Unknown user'|t('points') }}</span>
                {% endif %}
                {% if entry.event %}
                    <a href="{{ entry.event.getCpEditUrl() }}" style="font-size:11px; opacity:0.7;">{{ entry.event.name }}</a>
                {% endif %}
                <strong>+{{ entry.pointsSnapshot }}</strong>
                <span style="font-size:11px; opacity:0.5; white-space:nowrap;">{{ entry.dateCreated|timestamp }}</span>
            </li>
        {% endfor %}
    </ul>
{% else %}
    <p>{{ 'No entries yet.'|t('points') }}</p>
{% endif %}
