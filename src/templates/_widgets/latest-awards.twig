{% set pluralLabel = craft.points.currencyPlural %}

{% if awards|length %}
    <div class="tableview" style="padding-top: 24px;">
        <div class="tablepane">
            <table class="data fullwidth points-widget-table">
                <thead>
                    <tr>
                        <th>{{ 'Customer'|t('points') }}</th>
                        <th>{{ pluralLabel }}</th>
                        <th>{{ 'Date'|t('points') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for award in awards %}
                        <tr>
                            <td>
                                {% if award.user %}
                                    <div class="points-widget-user">
                                        <a href="{{ award.user.getCpEditUrl() }}" class="points-widget-avatar">
                                            {{ award.user.getThumbHtml(24)|raw }}
                                        </a>
                                        <a href="{{ award.user.getCpEditUrl() }}" class="points-widget-name">{{ award.user.name }}</a>
                                    </div>
                                {% else %}
                                    <div class="points-widget-user" style="opacity:0.5;">
                                        <span class="points-widget-avatar"></span>
                                        <span class="points-widget-name">{{ 'Unknown'|t('points') }}</span>
                                    </div>
                                {% endif %}
                            </td>
                            <td><a href="{{ award.getCpEditUrl() }}"><strong>+{{ award.pointsSnapshot }}</strong></a></td>
                            <td class="light">{{ award.dateCreated|timestamp }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% else %}
    <p>{{ 'No awards yet.'|t('points') }}</p>
{% endif %}

{% css %}
    .points-widget-user {
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .points-widget-avatar {
        display: inline-flex;
        width: 24px;
        height: 24px;
        border-radius: 50%;
        overflow: hidden;
        align-items: center;
        justify-content: center;
        background: var(--gray-050, #f3f4f6);
        flex-shrink: 0;
    }
    .points-widget-avatar > * { width: 100% !important; height: 100% !important; }
    .points-widget-avatar svg,
    .points-widget-avatar img { display: block; width: 100% !important; height: 100% !important; }
    .points-widget-name {
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
{% endcss %}
