{% if awards|length %}
    <ul style="margin:0; padding:0; list-style:none;">
        {% for award in awards %}
            <li style="padding:6px 0; border-bottom:1px solid rgba(0,0,0,.06); display:flex; align-items:center; gap:8px;">
                {% if award.user %}
                    <a href="{{ award.user.getCpEditUrl() }}" style="flex:1; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">{{ award.user.name }}</a>
                {% else %}
                    <span style="flex:1; opacity:0.5;">{{ 'Unknown user'|t('points') }}</span>
                {% endif %}
                {% if award.event %}
                    <a href="{{ award.event.getCpEditUrl() }}" style="font-size:11px; opacity:0.7;">{{ award.event.name }}</a>
                {% endif %}
                <strong>+{{ award.pointsSnapshot }}</strong>
                <span style="font-size:11px; opacity:0.5; white-space:nowrap;">{{ award.dateCreated|timestamp }}</span>
            </li>
        {% endfor %}
    </ul>
{% else %}
    <p>{{ 'No awards yet.'|t('points') }}</p>
{% endif %}
