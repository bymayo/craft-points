{# @var plugin \bymayo\points\Points #}
{# @var settings \bymayo\points\models\Settings #}

{% import '_includes/forms.twig' as forms %}

<h2>{{ 'Terminology'|t('points') }}</h2>

<p>{{ 'Rename the currency the plugin uses in the UI. The plugin handle, URLs and database don\'t change — only what your editors see.'|t('points') }}</p>

{{ forms.textField({
    first: true,
    label: 'Currency name'|t('points'),
    instructions: 'Singular. e.g. Point, Coin, Credit, Star.'|t('points'),
    id: 'currencyName',
    name: 'currencyName',
    value: settings.currencyName,
    required: true,
    errors: settings.getErrors('currencyName'),
}) }}

{{ forms.textField({
    label: 'Currency name (plural)'|t('points'),
    instructions: 'Plural. e.g. Points, Coins, Credits, Stars.'|t('points'),
    id: 'currencyNamePlural',
    name: 'currencyNamePlural',
    value: settings.currencyNamePlural,
    required: true,
    errors: settings.getErrors('currencyNamePlural'),
}) }}

<hr>

<h2>{{ 'User triggers'|t('points') }}</h2>

{{ forms.textField({
    label: 'Birthday field handle'|t('points'),
    instructions: 'Handle of a Date field on the user layout storing each user\'s birthday. Required for the "User birthday" trigger.'|t('points'),
    id: 'birthdayFieldHandle',
    name: 'birthdayFieldHandle',
    class: 'code',
    value: settings.birthdayFieldHandle,
}) }}

<hr>

<h2>{{ 'Money conversion'|t('points') }}</h2>

<p>{{ 'Used by `craft.points.toMoney()` to convert a point balance into a monetary value. Has no effect on how points are earned — just on how they\'re displayed when shown as currency.'|t('points') }}</p>

{{ forms.textField({
    label: 'Points per ' ~ settings.currencySymbol ~ '1'|t('points'),
    instructions: 'How many points equal one unit of currency. e.g. 100 means 100 points = ' ~ settings.currencySymbol ~ '1.'|t('points'),
    id: 'pointsPerCurrencyUnit',
    name: 'pointsPerCurrencyUnit',
    type: 'number',
    value: settings.pointsPerCurrencyUnit,
    errors: settings.getErrors('pointsPerCurrencyUnit'),
}) }}

{{ forms.textField({
    label: 'Currency symbol'|t('points'),
    instructions: 'Used by `formatMoney()` as a prefix.'|t('points'),
    id: 'currencySymbol',
    name: 'currencySymbol',
    value: settings.currencySymbol,
    errors: settings.getErrors('currencySymbol'),
}) }}

<hr>

<h2>{{ 'Edition'|t('points') }}</h2>

<p>
    {{ 'Current edition:'|t('points') }}
    <strong>{{ plugin.edition|capitalize }}</strong>
</p>

{% if plugin.is('lite') and not plugin.is('pro') %}
    <p class="light">
        {{ 'Upgrade to Pro to award points from Craft Commerce orders and subscriptions, and to use percentage-of-order point awards.'|t('points') }}
    </p>
{% endif %}
