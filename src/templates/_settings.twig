{# @var plugin \bymayo\points\Points #}
{# @var settings \bymayo\points\models\Settings #}

{% import '_includes/forms.twig' as forms %}

<h2>{{ 'Terminology'|t('points') }}</h2>

<p>{{ 'Rename the plugin and currency labels shown in the UI. The plugin handle, URLs and database don\'t change — only what your editors see.'|t('points') }}</p>

{{ forms.textField({
    first: true,
    label: 'Plugin name'|t('points'),
    instructions: 'Shown in the CP sidebar and breadcrumbs. Independent of the currency name. e.g. "Rewards System".'|t('points'),
    id: 'pluginName',
    name: 'pluginName',
    value: settings.pluginName,
    required: true,
    errors: settings.getErrors('pluginName'),
}) }}

{{ forms.textField({
    label: 'Currency name'|t('points'),
    instructions: 'Singular. e.g. Point, Coin, Credit, Star.'|t('points'),
    id: 'currencyName',
    name: 'currencyName',
    value: settings.currencyName,
    required: true,
    errors: settings.getErrors('currencyName'),
}) }}

{{ forms.textField({
    label: 'Currency name (plural)'|t('points'),
    instructions: 'Plural. e.g. Points, Coins, Credits, Stars.'|t('points'),
    id: 'currencyNamePlural',
    name: 'currencyNamePlural',
    value: settings.currencyNamePlural,
    required: true,
    errors: settings.getErrors('currencyNamePlural'),
}) }}

<hr>

<h2>{{ 'User triggers'|t('points') }}</h2>

{{ forms.textField({
    label: 'Birthday field handle'|t('points'),
    instructions: 'Handle of a Date field on the user layout storing each user\'s birthday. Required for the "User birthday" trigger.'|t('points'),
    id: 'birthdayFieldHandle',
    name: 'birthdayFieldHandle',
    class: 'code',
    value: settings.birthdayFieldHandle,
}) }}

<hr>

<h2>{{ 'Money conversion'|t('points') }}</h2>

<p>{{ 'Used by `craft.points.toMoney()` to convert a point balance into a monetary value. Has no effect on how points are earned — just on how they\'re displayed when shown as currency.'|t('points') }}</p>

{{ forms.textField({
    label: 'Points per ' ~ settings.currencySymbol ~ '1'|t('points'),
    instructions: 'How many points equal one unit of currency. e.g. 100 means 100 points = ' ~ settings.currencySymbol ~ '1.'|t('points'),
    id: 'pointsPerCurrencyUnit',
    name: 'pointsPerCurrencyUnit',
    type: 'number',
    value: settings.pointsPerCurrencyUnit,
    errors: settings.getErrors('pointsPerCurrencyUnit'),
}) }}

{{ forms.textField({
    label: 'Currency symbol'|t('points'),
    instructions: 'Used by `formatMoney()` as a prefix.'|t('points'),
    id: 'currencySymbol',
    name: 'currencySymbol',
    value: settings.currencySymbol,
    errors: settings.getErrors('currencySymbol'),
}) }}

{% if plugin.is('pro') and craft.app.plugins.isPluginEnabled('commerce') %}
    <hr>

    <h2>{{ 'Order redemptions'|t('points') }}</h2>
    <p>{{ 'Let logged-in customers spend points against Commerce orders. The discount appears as an order adjuster (like a coupon).'|t('points') }}</p>

    {{ forms.textField({
        label: 'Minimum to redeem'|t('points'),
        instructions: 'Smallest number of points a customer can apply in one go.'|t('points'),
        id: 'redemptionMinPoints',
        name: 'redemptionMinPoints',
        type: 'number',
        value: settings.redemptionMinPoints,
        errors: settings.getErrors('redemptionMinPoints'),
    }) }}

    {{ forms.textField({
        label: 'Max % of order'|t('points'),
        instructions: 'Highest portion of the order total points can cover (1–100).'|t('points'),
        id: 'redemptionMaxOrderPercent',
        name: 'redemptionMaxOrderPercent',
        type: 'number',
        value: settings.redemptionMaxOrderPercent,
        errors: settings.getErrors('redemptionMaxOrderPercent'),
    }) }}

    {{ forms.selectField({
        label: 'On refund'|t('points'),
        instructions: 'What to do with redeemed points when a transaction is refunded.'|t('points'),
        id: 'redemptionRefundBehaviour',
        name: 'redemptionRefundBehaviour',
        options: [
            { label: 'Restore proportionally'|t('points'), value: 'restoreProportional' },
            { label: 'Restore only on full refund'|t('points'), value: 'restoreFullOnly' },
            { label: 'Never restore (admin manual)'|t('points'), value: 'none' },
        ],
        value: settings.redemptionRefundBehaviour,
    }) }}
{% endif %}

<hr>

<h2>{{ 'Edition'|t('points') }}</h2>

<p>
    {{ 'Current edition:'|t('points') }}
    <strong>{{ plugin.edition|capitalize }}</strong>
</p>

{% if plugin.is('lite') and not plugin.is('pro') %}
    <p class="light">
        {{ 'Upgrade to Pro to award points from Craft Commerce orders and subscriptions, and to use percentage-of-order point awards.'|t('points') }}
    </p>
{% endif %}
